-- StarterGui.VOID WARE NEW.LocalScript
local function C_5()
local script = G2L["5"];
	-- Configuration
	local TELEPORT_DELAY = 0.5 -- Time in seconds to wait after respawning before teleporting (helps prevent physics glitches)
	
	-- Services
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	
	-- Variable to store the death position
	local lastDeathCFrame = nil
	
	-- Function to handle tracking death and respawn positioning
	local function monitorCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		local rootPart = character:WaitForChild("HumanoidRootPart", 10)
	
		if not humanoid or not rootPart then return end
	
		-- 1. Track when the character dies and save the position
		humanoid.Died:Connect(function()
			if rootPart then
				lastDeathCFrame = rootPart.CFrame
			end
		end)
	end
	
	-- 2. Track when a new character spawns and teleport them back
	player.CharacterAdded:Connect(function(newCharacter)
		-- Start monitoring the new character for their next death
		monitorCharacter(newCharacter)
	
		-- If we have a saved death position, teleport the player back to it
		if lastDeathCFrame then
			local newRootPart = newCharacter:WaitForChild("HumanoidRootPart", 10)
			if newRootPart then
				task.wait(TELEPORT_DELAY)
				newRootPart.CFrame = lastDeathCFrame
				lastDeathCFrame = nil -- Reset until the next death
			end
		end
	end)
	
	-- Initialize the script for the current character alive right now
	if player.Character then
		monitorCharacter(player.Character)
	end
	
end;
