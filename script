		say.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		say.TextScaled = true
		say.Parent = vman.ScrollingFrame
		say.TextScaled = false
		say.TextWrapped = false	say.TextScaled = false
		say.TextSize = 14
		say.FontFace = Font.new([[rbxasset://fonts/families/PressStart2P.json]], Enum.FontWeight.Regular, Enum.FontStyle.Normal);
		
		nameVal.Value += 1
		posVal.Value += 30
	
		say.Name = tostring(nameVal.Value)
		say.Position = UDim2.new(0, 0, 0, posVal.Value)  -- use pixel offset
		if not flying then
			startFlying()
			say.Text = "flying on"
		else
			stopFlying()
	say.Text = "flying off"
	
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not flying then
			return
		end
	
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = true
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = true
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = true
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = true
	
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			moveUp = true
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = true
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = false
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = false
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = false
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = false
	
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			moveUp = false
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end
	
		if not character or not character.Parent then
			getCharacterParts()
			return
		end
	
		local camera = workspace.CurrentCamera
	
		local moveVector = Vector3.zero
	
		local lookVector = camera.CFrame.LookVector
		local rightVector = camera.CFrame.RightVector
	
		if moveForward then
			moveVector += lookVector
		end
	
		if moveBack then
			moveVector -= lookVector
		end
	
		if moveRight then
			moveVector += rightVector
		end
	
		if moveLeft then
			moveVector -= rightVector
		end
	
		if moveUp then
			moveVector += Vector3.new(0, 1, 0)
		end
	
		if moveDown then
			moveVector -= Vector3.new(0, 1, 0)
		end
	
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit * speed
		end
	
		-- Physics-based movement.
		-- Because the player's character is client-owned,
		-- the resulting physics state can replicate to other players.
		rootPart.AssemblyLinearVelocity = moveVector
	end)
