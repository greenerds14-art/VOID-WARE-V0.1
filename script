	local btn = script.Parent
	local plr = game.Players.LocalPlayer
	local gui = script.Parent.Parent.Parent.Parent
	local vman = gui["status effects frame"]
	local nameVal = gui.name_val       -- the IntValue object
	local posVal = gui.Value           -- the IntValue object
	local offon = false
	
	btn.MouseButton1Click:Connect(function()
		local char = plr.Character
		if not char then return end
	
		local hum = char:FindFirstChildOfClass("Humanoid")
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp then return end
	
		-- Correctly fallback to the alternative UI text field if the primary one is empty
		local targetName = script.Parent.Parent.Parent.User.Text
		if targetName == "" or targetName == "User" then
			targetName = script.Parent.Parent.Parent["SELECTED PLAYER"].Text
		end
	
		-- Verify the target exists in workspace before proceeding
		local plrtotpto = workspace:FindFirstChild(targetName)
		if not plrtotpto or not plrtotpto:FindFirstChild("HumanoidRootPart") then
			warn("Target player or their HumanoidRootPart could not be found.")
			return
		end
	
		offon = not offon
	
		-- UI Creation
		local say = Instance.new("TextLabel")
		say.Size = UDim2.new(0, 224, 0, 37)
		say.TextColor3 = Color3.fromRGB(255, 255, 255)
		say.BackgroundTransparency = 1
		say.TextStrokeTransparency = 0
		say.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		say.TextSize = 14
		say.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		say.Parent = vman.ScrollingFrame
	
		nameVal.Value += 1
		posVal.Value += 30
	
		say.Name = tostring(nameVal.Value)
		say.Position = UDim2.new(0, 0, 0, posVal.Value)
	
		if offon and hrp.Position.Y <= 200 then
			say.Text = "Flinging " .. targetName
	
			-- Disable character collision safely
			for _, v in pairs(char:GetChildren()) do
				if v:IsA("BasePart") then
					v.CanCollide = (v.Name == "HumanoidRootPart")
				end
			end
	
			-- Loop sequence
			while offon and hrp.Position.Y <= 200 and plrtotpto:FindFirstChild("HumanoidRootPart") do
				task.wait()
				hrp.Velocity = Vector3.new(0, 99999, 0)
				-- Using CFrame instead of Position prevents physics/joint breaking bugs
				hrp.CFrame = plrtotpto.HumanoidRootPart.CFrame 
	
				if hrp.Position.Y >= 200 then
					hrp.CFrame = CFrame.new(0, 100, 0)
					for _, v in pairs(char:GetChildren()) do
						if v:IsA("BasePart") then
							v.CanCollide = true
						end
					end
					offon = false
					break
				end
			end
		else
			say.Text = "Stopped Flinging " .. targetName
			for _, v in pairs(char:GetChildren()) do
				if v:IsA("BasePart") then
					v.CanCollide = true
					hrp.Velocity = Vector3.new(0, 0, 0)
				end
			end
			hrp.CFrame = CFrame.new(0, 100, 0)
		end
	end)
	
