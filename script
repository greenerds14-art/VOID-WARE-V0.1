	local button = script.Parent
	local Workspace = game:GetService("Workspace")
	local TextChatService = game:GetService("TextChatService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	
	local localPlayer = Players.LocalPlayer
	local agstatus = false
	local activeConnections = {} 
	local folderConnections = {}
	
	-- Griefer Tracking Data
	local destructionCounters = {} -- Tracks how many blocks each user has broken
	local STREAK_THRESHOLD = 5     -- Number of blocks needed to trigger the alert
	local POV_DURATION = 3         -- How many seconds to spectate the player
	
	-- Bulletproof chat sending function
	local function sendToChat(textToSend)
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local textChannels = TextChatService:FindFirstChild("TextChannels")
			if textChannels then
				local general = textChannels:FindFirstChild("RBXGeneral")
				if general then
					general:SendAsync(textToSend)
				end
			end
		else
			local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if chatEvents then
				local sayMessage = chatEvents:FindFirstChild("SayMessageRequest")
				if sayMessage and sayMessage:IsA("RemoteEvent") then
					sayMessage:FireServer(textToSend, "All")
				end
			end
		end
	end
	
	-- Spectate target function
	local function povGriefer(grieferName)
		local targetPlayer = Players:FindFirstChild(grieferName)
		if not targetPlayer or not targetPlayer.Character then return end
		local targetHumanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
	
		if targetHumanoid and Workspace.CurrentCamera then
			local currentCamera = Workspace.CurrentCamera
	
			-- Force your camera to view the target player
			currentCamera.CameraSubject = targetHumanoid
			print("[VOID WARE]: POV locked onto " .. grieferName)
	
			-- Wait for the duration, then reset back to yourself
			task.delay(POV_DURATION, function()
				if localPlayer.Character then
					local myHumanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
					if myHumanoid then
						currentCamera.CameraSubject = myHumanoid
						print("[VOID WARE]: Camera returned to local player.")
					end
				end
			end)
		end
	end
	
	-- Helper function to find who is nearest to the block with a tool out
	local function getClosestGriefer(blockPosition, victimName)
		local closestPlayer = "Unknown Player"
		local shortestDistance = 18
	
		for _, p in pairs(Players:GetPlayers()) do
			if p.Name ~= victimName and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local rootPart = p.Character.HumanoidRootPart
				local dist = (rootPart.Position - blockPosition).Magnitude
	
				if dist < shortestDistance then
					local holdingTool = p.Character:FindFirstChildOfClass("Tool")
					if holdingTool then
						shortestDistance = dist
						closestPlayer = p.Name
					end
				end
			end
		end
	
		if closestPlayer == "Unknown Player" then
			for _, p in pairs(Players:GetPlayers()) do
				if p.Name ~= victimName and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (p.Character.HumanoidRootPart.Position - blockPosition).Magnitude
					if dist < 15 then 
						closestPlayer = p.Name
						break
					end
				end
			end
		end
	
		return closestPlayer
	end
	
	-- Function to track a player model inside the Bricks folder
	local function trackPlayerModel(playerModel)
		if not playerModel:IsA("Model") then return end
		local victimName = playerModel.Name
	
		if activeConnections[playerModel] then return end
	
		local connection = playerModel.ChildRemoved:Connect(function(child)
			if not agstatus then return end
	
			-- Ignore completely if you delete your own block
			if victimName == localPlayer.Name then return end
	
			if child:IsA("BasePart") then
				local destroyer = getClosestGriefer(child.Position, victimName)
	
				-- Skip if the block owner deleted it themselves
				if destroyer == "Unknown Player" then return end
	
				-- Increment the griefer's destruction score
				if not destructionCounters[destroyer] then
					destructionCounters[destroyer] = 0
				end
				destructionCounters[destroyer] = destructionCounters[destroyer] + 1
	
				print(string.format("[VOID WARE]: %s destruction streak: %d/%d", destroyer, destructionCounters[destroyer], STREAK_THRESHOLD))
	
				-- ONLY trigger the alert and POV when they hit exactly 5 deletions (or multiples of 5)
				if destructionCounters[destroyer] % STREAK_THRESHOLD == 0 then
					-- 1. Lock camera onto them for 3 seconds
					povGriefer(destroyer)
	
					-- 2. Broadcast to the server chat
					local textToSend = destroyer .. " is currently griefing! (Destroyed " .. tostring(destructionCounters[destroyer]) .. " of " .. victimName .. "'s bricks)"
					sendToChat(textToSend)
				end
			end
		end)
	
		activeConnections[playerModel] = connection
	end
	
	-- Function to turn on the detector
	local function turnOnAntiGrief()
		local BricksFolder = Workspace:WaitForChild("Bricks", 10)
		if not BricksFolder then
			warn("[VOID WARE]: Could not find the 'Bricks' folder in Workspace.")
			return
		end
	
		print("[VOID WARE]: Advanced block deletion detector activated.")
		destructionCounters = {} -- Reset scores on activation
	
		for _, child in pairs(BricksFolder:GetChildren()) do
			trackPlayerModel(child)
		end
	
		local childAddedConn = BricksFolder.ChildAdded:Connect(function(newChild)
			task.wait(0.1) 
			trackPlayerModel(newChild)
		end)
		table.insert(folderConnections, childAddedConn)
	end
	
	-- Function to turn off the detector safely
	local function turnOffAntiGrief()
		for model, connection in pairs(activeConnections) do
			if connection then connection:Disconnect() end
		end
		activeConnections = {}
	
		for _, connection in pairs(folderConnections) do
			if connection then connection:Disconnect() end
		end
		folderConnections = {}
	
		print("[VOID WARE]: Detector deactivated.")
	end
	
	-- Button click handler
	button.MouseButton1Click:Connect(function()
		agstatus = not agstatus
	
		if agstatus then
			script.Parent.Parent["Anti Grief status"].Text = "ON"
			turnOnAntiGrief()
		else
			script.Parent.Parent["Anti Grief status"].Text = "OFF"
			turnOffAntiGrief()
		end
	end)
	
end;
