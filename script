-- StarterGui.VOID WARE.Frame.ScrollingFrame.fling.LocalScript
local function C_19()
local script = G2L["19"];
	local button = script.Parent
	local Workspace = game:GetService("Workspace")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local isFlinging = false 
	
	button.MouseButton1Click:Connect(function()
		if isFlinging then return end 
	
		local player = Players.LocalPlayer
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
		-- Extract UI input values
		local rawVelo = script.Parent.Parent["cool val"].Value
		local velocityPower = "inf" -- High limit for physics breaking
		local targetName = script.Parent.Parent.TextBox2.Text
		local targetModel = Workspace:FindFirstChild(targetName)
		local targetRoot = targetModel and targetModel:FindFirstChild("HumanoidRootPart")
	
		if not rootPart or not targetRoot or not humanoid then
			warn("[VOID WARE]: Missing local character components or invalid target player.")
			return
		end
	
		isFlinging = true
		button.Text = "FLINGING..."
		script.Parent.Parent.Parent.Parent.noti.Frame["fade in"].Enabled = true
		script.Parent.Parent.Parent.Parent.noti.Frame.TextLabel.Text = "Flung " .. targetName
	
		-- Save original location to return you safely afterward
		local originalCFrame = rootPart.CFrame
	
		-- 1. Break humanoid upright constraints
		humanoid.PlatformStand = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	
		-- Turn off collision on secondary limbs to prevent tripping early
		for _, part in pairs(character:GetChildren()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				part.CanCollide = false
			end
		end
	
		-- 2. Inject Legacy Velocity Object for High Torque Rotational Speed
		local bAngular = Instance.new("BodyAngularVelocity")
		bAngular.MaxTorque = Vector3.new("inf", "inf", "inf")
		bAngular.P = "inf" -- Maximizes power transmission
		bAngular.AngularVelocity = Vector3.new(velocityPower, velocityPower, velocityPower)
		bAngular.Parent = rootPart
	
		-- 3. Execute dual-velocity frame-by-frame collision loop
		local loopCount = 0
		local maxLoops = 380 -- Roughly 3 seconds of active execution
	
		local physicsConnection
		physicsConnection = RunService.Heartbeat:Connect(function()
			if loopCount >= maxLoops or not targetRoot or not targetRoot.Parent or not rootPart or not rootPart.Parent then
				physicsConnection:Disconnect()
				return
			end
			loopCount = loopCount + 1
	
			-- Force strict physical positioning right into the core of their hitbox
			rootPart.CFrame = targetRoot.CFrame * CFrame.new(math.random(-1, 1) * 0.1, 0, math.random(-1, 1) * 0.1)
	
			-- DUAL VELOCITY OVERRIDE: 
			-- Continually spikes AssemblyLinearVelocity to extreme negative parameters on every internal physics frame
			rootPart.AssemblyLinearVelocity = Vector3.new(-velocityPower, -velocityPower, -velocityPower)
		end)
	
		-- Wait until execution finishes
		while physicsConnection.Connected do task.wait() end
	
		-- 4. Clean up physics movers and return you safely
		if bAngular then bAngular:Destroy() end
	
		if rootPart and rootPart.Parent then
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
			rootPart.CFrame = originalCFrame
		end
	
		if humanoid and humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	
		for _, part in pairs(character:GetChildren()) do
			if part:IsA("BasePart") then
				part.CanCollide = true
			end
		end
	
		isFlinging = false
		button.Text = "FLING"
	end)
	
end;
task.spawn(C_19);
