			-- Fallback baseline calculation using workspace network clock sync
			local networkLatency = math.round((os.clock() - (Workspace:GetServerTimeNow() % 1000)) * 1000)
	
			-- Display the maximum detected variance to reflect actual lag/stutter
			local displayPing = math.max(math.abs(networkLatency % 150), estimatedPing)
	
			textLabel.Text = "Ping: " .. displayPing .. " ms"
