-- StarterGui.VOID WARE.Frame.ScrollingFrame.Fly.LocalScript
local function C_1e()
local script = G2L["1e"];
	local button = script.Parent
	
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	
	local flying = false
	
	local moveForward = false
	local moveBack = false
	local moveLeft = false
	local moveRight = false
	local moveUp = false
	local moveDown = false
	
	local speed = 50
	
	local character
	local humanoid
	local rootPart
	
	local function getCharacterParts()
		character = player.Character or player.CharacterAdded:Wait()
		humanoid = character:WaitForChild("Humanoid")
		rootPart = character:WaitForChild("HumanoidRootPart")
	
		-- Make sure the client owns the character's physics.
		-- Player characters normally have client network ownership.
		pcall(function()
			rootPart:SetNetworkOwner(player)
		end)
	
		return character, humanoid, rootPart
	end
	
	getCharacterParts()
	
	player.CharacterAdded:Connect(function()
		task.wait(0.1)
		getCharacterParts()
	
		if flying then
			humanoid.PlatformStand = true
		end
	end)
	
	local function stopFlying()
		flying = false
	
		getCharacterParts()
	
		moveForward = false
		moveBack = false
		moveLeft = false
		moveRight = false
		moveUp = false
		moveDown = false
	
		humanoid.PlatformStand = false
	
		-- Stop the flying velocity.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	local function startFlying()
		flying = true
	
		getCharacterParts()
	
		humanoid.PlatformStand = true
	
		-- Remove existing velocity when starting.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	button.MouseButton1Click:Connect(function()
		if not flying then
			startFlying()
	
			script.Parent.Parent["Fly Status"].Text = "ON"
			script.Parent.Parent.Parent.Parent.noti.Frame["fade in"].Enabled = true
			script.Parent.Parent.Parent.Parent.noti.Frame.TextLabel.Text = "flying on"
		else
			stopFlying()
	
			script.Parent.Parent["Fly Status"].Text = "OFF"
			script.Parent.Parent.Parent.Parent.noti.Frame["fade in"].Enabled = true
			script.Parent.Parent.Parent.Parent.noti.Frame.TextLabel.Text = "flying off"
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not flying then
			return
		end
	
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = true
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = true
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = true
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = true
	
		elseif input.KeyCode == Enum.KeyCode.Space then
			moveUp = true
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = true
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = false
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = false
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = false
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = false
	
		elseif input.KeyCode == Enum.KeyCode.Space then
			moveUp = false
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end
	
		if not character or not character.Parent then
			getCharacterParts()
			return
		end
	
		local camera = workspace.CurrentCamera
	
		local moveVector = Vector3.zero
	
		local lookVector = camera.CFrame.LookVector
		local rightVector = camera.CFrame.RightVector
	
		if moveForward then
			moveVector += lookVector
		end
	
		if moveBack then
			moveVector -= lookVector
		end
	
		if moveRight then
			moveVector += rightVector
		end
	
		if moveLeft then
			moveVector -= rightVector
		end
	
		if moveUp then
			moveVector += Vector3.new(0, 1, 0)
		end
	
		if moveDown then
			moveVector -= Vector3.new(0, 1, 0)
		end
	
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit * speed
		end
	
