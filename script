	local lastLocalTime = os.clock()
	local estimatedPing = 0
	
	-- Track time drift between local frame renders and server time updates
	RunService.Heartbeat:Connect(function()
		local currentServerTime = Workspace:GetServerTimeNow()
		local currentLocalTime = os.clock()
	
		local serverDelta = currentServerTime - lastServerTime
		local localDelta = currentLocalTime - lastLocalTime
	
		-- Calculate latency variance in milliseconds
		if serverDelta > 0 then
			local timeDifference = math.abs(localDelta - serverDelta)
			-- Smooth out the ping display over time
			estimatedPing = math.round(timeDifference * 1000)
		end
	
		lastServerTime = currentServerTime
		lastLocalTime = currentLocalTime
	end)
	
	-- Update display every second
	task.spawn(function()
