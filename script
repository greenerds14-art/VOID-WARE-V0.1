-- StarterGui.VOID WARE.Frame.ScrollingFrame.ANTI GRIEF.LocalScript
local function C_33()
local script = G2L["33"];
	local button = script.Parent
	local Workspace = game:GetService("Workspace")
	local TextChatService = game:GetService("TextChatService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	
	local localPlayer = Players.LocalPlayer
	local agstatus = false
	local activeConnections = {} 
	local folderConnections = {}
	
	-- Bulletproof chat sending function
	local function sendToChat(textToSend)
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local textChannels = TextChatService:FindFirstChild("TextChannels")
			if textChannels then
				local general = textChannels:FindFirstChild("RBXGeneral")
				if general then
					general:SendAsync(textToSend)
				end
			end
		else
			local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if chatEvents then
				local sayMessage = chatEvents:FindFirstChild("SayMessageRequest")
				if sayMessage and sayMessage:IsA("RemoteEvent") then
					sayMessage:FireServer(textToSend, "All")
				end
			end
		end
	end
	
	-- Helper function to find who is nearest to the block with a tool out
	local function getClosestGriefer(blockPosition, victimName)
		local closestPlayer = "Unknown Player"
		local shortestDistance = 18 -- Radii threshold (studs) to check around the block
	
		for _, p in pairs(Players:GetPlayers()) do
			-- ====================================================================
			-- FIX: Skip the block owner! If the owner is closest, it's not a griefer.
			-- ====================================================================
			if p.Name ~= victimName and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
				local rootPart = p.Character.HumanoidRootPart
				local dist = (rootPart.Position - blockPosition).Magnitude
	
				if dist < shortestDistance then
					-- Check if they are holding a tool (likely their delete/bkit tool)
					local holdingTool = p.Character:FindFirstChildOfClass("Tool")
					if holdingTool then
						shortestDistance = dist
						closestPlayer = p.Name
					end
				end
			end
		end
	
		-- Fallback: Check by absolute closest proximity (still skipping the owner)
		if closestPlayer == "Unknown Player" then
			for _, p in pairs(Players:GetPlayers()) do
				if p.Name ~= victimName and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local dist = (p.Character.HumanoidRootPart.Position - blockPosition).Magnitude
					if dist < 15 then 
						closestPlayer = p.Name
						break
					end
				end
			end
		end
	
		return closestPlayer
	end
	
	-- Function to track a player model inside the Bricks folder
	local function trackPlayerModel(playerModel)
		if not playerModel:IsA("Model") then return end
		local victimName = playerModel.Name
	
		if activeConnections[playerModel] then return end
	
		local connection = playerModel.ChildRemoved:Connect(function(child)
			if not agstatus then return end
	
			-- Skip entirely if you delete your own block
			if victimName == localPlayer.Name then return end
	
			if child:IsA("BasePart") then
				-- 1. Find if an external player is standing close to the deletion site
				local destroyer = getClosestGriefer(child.Position, victimName)
	
				-- 2. Double-check: If the script returned "Unknown Player" because the owner was the 
				-- only one nearby, that means the owner deleted it themselves. Exit out.
				if destroyer == "Unknown Player" then
					return
				end
	
				-- 3. Broadcast if a valid third-party player was caught
				local textToSend = victimName .. "'s build has been griefed by " .. destroyer .. "!"
				sendToChat(textToSend)
			end
		end)
	
		activeConnections[playerModel] = connection
	end
	
	-- Function to turn on the detector
	local function turnOnAntiGrief()
		local BricksFolder = Workspace:WaitForChild("Bricks", 10)
		if not BricksFolder then
			warn("[VOID WARE]: Could not find the 'Bricks' folder in Workspace.")
			return
		end
	
		print("[VOID WARE]: Advanced block deletion detector activated.")
	
		for _, child in pairs(BricksFolder:GetChildren()) do
			trackPlayerModel(child)
		end
	
		local childAddedConn = BricksFolder.ChildAdded:Connect(function(newChild)
			task.wait(0.1) 
			trackPlayerModel(newChild)
		end)
		table.insert(folderConnections, childAddedConn)
	end
	
	-- Function to turn off the detector safely
	local function turnOffAntiGrief()
		for model, connection in pairs(activeConnections) do
			if connection then connection:Disconnect() end
		end
		activeConnections = {}
	
		for _, connection in pairs(folderConnections) do
			if connection then connection:Disconnect() end
		end
		folderConnections = {}
	
		print("[VOID WARE]: Detector deactivated.")
	end
	
	-- Button click handler
	button.MouseButton1Click:Connect(function()
		agstatus = not agstatus
	
		if agstatus then
			script.Parent.Parent["Anti Grief status"].Text = "ON"
			turnOnAntiGrief()
		else
			script.Parent.Parent["Anti Grief status"].Text = "OFF"
			turnOffAntiGrief()
		end
	end)
	
end;
task.spawn(C_33);
