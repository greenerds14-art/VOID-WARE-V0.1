local function C_f()
local script = G2L["f"];
	local button = script.Parent
	
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	
	local flying = false
	
	local moveForward = false
	local moveBack = false
	local moveLeft = false
	local moveRight = false
	local moveUp = false
	local moveDown = false
	
	local speed = 50
	
	local character
	local humanoid
	local rootPart
	
	local function getCharacterParts()
		character = player.Character or player.CharacterAdded:Wait()
		humanoid = character:WaitForChild("Humanoid")
		rootPart = character:WaitForChild("HumanoidRootPart")
	
		-- Make sure the client owns the character's physics.
		-- Player characters normally have client network ownership.
		pcall(function()
			rootPart:SetNetworkOwner(player)
		end)
	
		return character, humanoid, rootPart
	end
	
	getCharacterParts()
	
	player.CharacterAdded:Connect(function()
		task.wait(0.1)
		getCharacterParts()
	
		if flying then
			humanoid.PlatformStand = true
		end
	end)
	
	local function stopFlying()
		flying = false
	
		getCharacterParts()
	
		moveForward = false
		moveBack = false
		moveLeft = false
		moveRight = false
		moveUp = false
		moveDown = false
	
		humanoid.PlatformStand = false
	
		-- Stop the flying velocity.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	local function startFlying()
		flying = true
	
		getCharacterParts()
	
		humanoid.PlatformStand = true
	
		-- Remove existing velocity when starting.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	button.MouseButton1Click:Connect(function()
		local gui = script.Parent.Parent.Parent.Parent
		local vman = gui["status effects frame"]
		local nameVal = gui.name_val       -- the IntValue object
		local posVal = gui.Value           -- the IntValue object
		local say = Instance.new("TextLabel")
		say.Size = UDim2.new(0, 224, 0, 37)
		say.TextColor3 = Color3.fromRGB(255, 255, 255)
		say.BackgroundTransparency = 1
		say.TextStrokeTransparency = 0
		say.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		say.TextScaled = true
		say.Parent = vman.ScrollingFrame
		say.TextScaled = false
		say.TextWrapped = false	say.TextScaled = false
		say.TextSize = 14
		say.FontFace = Font.new([[rbxasset://fonts/families/PressStart2P.json]], Enum.FontWeight.Regular, Enum.FontStyle.Normal);
		
		nameVal.Value += 1
		posVal.Value += 30
	
		say.Name = tostring(nameVal.Value)
		say.Position = UDim2.new(0, 0, 0, posVal.Value)  -- use pixel offset
		if not flying then
			startFlying()
			say.Text = "flying on"
		else
			stopFlying()
	say.Text = "flying off"
	
		end
	end)
	
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed or not flying then
			return
		end
	
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = true
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = true
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = true
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = true
	
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			moveUp = true
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = true
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.W then
			moveForward = false
	
		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = false
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = false
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = false
	
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			moveUp = false
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end
	
		if not character or not character.Parent then
			getCharacterParts()
			return
		end
	
		local camera = workspace.CurrentCamera
	
		local moveVector = Vector3.zero
	
		local lookVector = camera.CFrame.LookVector
		local rightVector = camera.CFrame.RightVector
	
		if moveForward then
			moveVector += lookVector
		end
	
		if moveBack then
			moveVector -= lookVector
		end
	
		if moveRight then
			moveVector += rightVector
		end
	
		if moveLeft then
			moveVector -= rightVector
		end
	
		if moveUp then
			moveVector += Vector3.new(0, 1, 0)
		end
	
		if moveDown then
			moveVector -= Vector3.new(0, 1, 0)
		end
	
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit * speed
		end
	
		-- Physics-based movement.
		-- Because the player's character is client-owned,
		-- the resulting physics state can replicate to other players.
		rootPart.AssemblyLinearVelocity = moveVector
	end)
end;
