		moveForward = false
		moveBack = false
		moveLeft = false
		moveRight = false
		moveUp = false
		moveDown = false
	
		humanoid.PlatformStand = false
	
		-- Stop the flying velocity.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	local function startFlying()
		flying = true
	
		getCharacterParts()
	
		humanoid.PlatformStand = true
	
		-- Remove existing velocity when starting.
		rootPart.AssemblyLinearVelocity = Vector3.zero
	end
	
	button.MouseButton1Click:Connect(function()
		local gui = script.Parent.Parent.Parent.Parent
		local vman = gui["status effects frame"]
