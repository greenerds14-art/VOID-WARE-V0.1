		-- Correctly fallback to the alternative UI text field if the primary one is empty
		local targetName = script.Parent.Parent.Parent.User.Text
		if targetName == "" or targetName == "User" then
			targetName = script.Parent.Parent.Parent["SELECTED PLAYER"].Text
		end
	
		-- Verify the target exists in workspace before proceeding
		local plrtotpto = workspace:FindFirstChild(targetName)
		if not plrtotpto or not plrtotpto:FindFirstChild("HumanoidRootPart") then
			warn("Target player or their HumanoidRootPart could not be found.")
			return
		end
	
		offon = not offon
	
