				instance.Transparency = 0
			end
		end
	end
	
	-- Function to create or update the Name Billboard UI
	local function updateBillboard(player, character)
		if player == LocalPlayer then return end
	
		local head = character:FindFirstChild("Head")
		if not head then return end
	
		local billboard = head:FindFirstChild("AntiInvisNameTag")
		local nameLabel
	
		if not billboard then
			billboard = Instance.new("BillboardGui")
			billboard.Name = "AntiInvisNameTag"
			billboard.Adornee = head
			billboard.Size = UDim2.new(0, 200, 0, 40)
			billboard.StudsOffset = Vector3.new(0, 2.5, 0)
			billboard.AlwaysOnTop = true
			billboard.Parent = head
	
			nameLabel = Instance.new("TextLabel")
			nameLabel.Name = "Label"
			nameLabel.Size = UDim2.new(1, 0, 1, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = player.DisplayName .. "\n(@" .. player.Name .. ")"
			nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
			nameLabel.TextStrokeTransparency = 0
			nameLabel.TextSize = 13
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.Parent = billboard
		else
			nameLabel = billboard:FindFirstChild("Label")
		end
	
		-- Color conditions (Chosen team overrides Arkenstone)
		if nameLabel then
			if Teams:FindFirstChild("Chosen") and player.Team == Teams.Chosen then
				nameLabel.TextColor3 = Color3.fromRGB(255, 255, 0) -- Yellow
			elseif hasArkenstone(player, character) or player:GetAttribute("Arken") == true then
				nameLabel.TextColor3 = Color3.fromRGB(0, 155, 255) -- Blue
			else
				nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255) -- White
			end
		end
	end
	
	-- Function to clean up all active Billboard UIs across the game
	local function removeAllBillboards()
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then
				local head = player.Character:FindFirstChild("Head")
				if head then
					local tag = head:FindFirstChild("AntiInvisNameTag")
					if tag then
						tag:Destroy()
					end
				end
			end
		end
	end
	
	-- Starts the anti-invisibility process
	local function StartOutline()
		if IsActive then return end
		IsActive = true
	
		RenderConnection = RunService.RenderStepped:Connect(function()
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local char = player.Character
	
					-- Maintain Billboard UI
					updateBillboard(player, char)
	
					-- Force full visibility on all parts
					for _, child in ipairs(char:GetDescendants()) do
						revealPart(child)
					end
				end
			end
		end)
	end
	
	-- Stops the anti-invisibility process and removes tags
	local function StopOutline()
		if not IsActive then return end
		IsActive = false
	
		if RenderConnection then
			RenderConnection:Disconnect()
			RenderConnection = nil
		end
	
		removeAllBillboards()
	end
	
	-- Chat Command Logic Execution
	local function processCommand(msg)
		local lowerMsg = msg:lower():gsub("%s+", "")
		if lowerMsg == "/antinvis" then
			StartOutline()
		elseif lowerMsg == "/stop" then
			StopOutline()
		end
	end
	
	-- TextChatService handling (New Roblox Chat System)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		TextChatService.OnIncomingMessage = function(message)
			if message.TextSource and message.TextSource.UserId == LocalPlayer.UserId then
				processCommand(message.Text)
			end
		end
	end
	
	-- Legacy Chat handling fallback
	LocalPlayer.Chatted:Connect(function(msg)
		processCommand(msg)
	end)
