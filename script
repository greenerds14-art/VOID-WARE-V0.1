		elseif input.KeyCode == Enum.KeyCode.S then
			moveBack = false
	
		elseif input.KeyCode == Enum.KeyCode.A then
			moveLeft = false
	
		elseif input.KeyCode == Enum.KeyCode.D then
			moveRight = false
	
		elseif input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.E then
			moveUp = false
	
		elseif input.KeyCode == Enum.KeyCode.Q then
			moveDown = false
		end
	end)
	
	RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end
	
		if not character or not character.Parent then
			getCharacterParts()
			return
		end
	
		local camera = workspace.CurrentCamera
	
		local moveVector = Vector3.zero
	
		local lookVector = camera.CFrame.LookVector
		local rightVector = camera.CFrame.RightVector
	
		if moveForward then
			moveVector += lookVector
		end
	
		if moveBack then
			moveVector -= lookVector
		end
	
		if moveRight then
			moveVector += rightVector
		end
	
		if moveLeft then
			moveVector -= rightVector
		end
	
		if moveUp then
			moveVector += Vector3.new(0, 1, 0)
		end
	
		if moveDown then
			moveVector -= Vector3.new(0, 1, 0)
		end
	
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit * speed
		end
	
		-- Physics-based movement.
		-- Because the player's character is client-owned,
		-- the resulting physics state can replicate to other players.
		rootPart.AssemblyLinearVelocity = moveVector
	end)
